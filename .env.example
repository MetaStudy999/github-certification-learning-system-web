# Application
NEXT_PUBLIC_APP_NAME=GCLS Web
APP_ENV=local

# GCLS content repository
GCLS_CONTENT_PROVIDER=auto
GCLS_CONTENT_DIR=../github-certification-learning-system
GCLS_CONTENT_REPOSITORY=MetaStudy999/github-certification-learning-system
GCLS_CONTENT_REF=main

# AI mode: mock | local | api | hybrid
AI_MODE=mock

# Ollama / local AI
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# OpenAI API (server-side only; never use NEXT_PUBLIC_)
# Direct provider uses the Responses API endpoint: ${OPENAI_BASE_URL}/responses
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Supabase Local / Cloud
# Local: `npm run supabase:start` then `npm run supabase:status`.
# Use a publishable key in cloud. The local CLI legacy anon key can be used here during local development.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side grading, Wrong Answer, Mock, Readiness and AI interaction writes require a server-only secret/service-role credential.
# Never expose either value through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
