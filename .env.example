# Application
NEXT_PUBLIC_APP_NAME=GCLS Web
APP_ENV=local

# GCLS content repository
GCLS_CONTENT_PROVIDER=auto
GCLS_CONTENT_DIR=../github-certification-learning-system
GCLS_CONTENT_REPOSITORY=MetaStudy999/github-certification-learning-system
GCLS_CONTENT_REF=main
# Optional but recommended in CI/deployments: exact content commit SHA for RAG freshness checks.
GCLS_CONTENT_VERSION=

# AI generation mode: mock | local | api | hybrid
AI_MODE=mock

# Ollama / local AI
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# OpenAI API (server-side only; never use NEXT_PUBLIC_)
# Direct provider uses the Responses API endpoint: ${OPENAI_BASE_URL}/responses
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# P8 RAG / Embeddings
# Embedding mode is intentionally pinned per index: mock | local | api (no hybrid vector-space mixing).
RAG_EMBEDDING_MODE=mock
RAG_EMBEDDING_DIMENSIONS=384
OLLAMA_EMBEDDING_MODEL=all-minilm
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# off | optional | required. Recommended after the first successful index: required.
RAG_GROUNDING_MODE=required
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.05
# Server-only token used only by POST /api/rag/index. Replace locally and never commit a real value.
RAG_INDEX_TOKEN=replace-with-local-secret

# Supabase Local / Cloud
# Local: `npm run supabase:start` then `npm run supabase:status`.
# Use a publishable key in cloud. The local CLI legacy anon key can be used here during local development.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side grading, Wrong Answer, Mock, Readiness, AI and RAG writes require a server-only secret/service-role credential.
# Never expose either value through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
